---
export interface Props {
  title: string;
  description: string;
  path?: string;
  base?: string;
}
const { title, description, path = "/", base = "" } = Astro.props;
const site = "https://remoteteampartners.com";
const canonical = `${site}${path}`;
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Remote Team Partners" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site + "/og-cover.jpg"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Remote Team Partners logo" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={site + "/og-cover.jpg"} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#2742f5" />
  <link rel="icon" href={base + "favicon.ico"} sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href={base + "images/favicon-16.png"} />
  <link rel="icon" type="image/png" sizes="32x32" href={base + "images/favicon-32.png"} />
  <link rel="apple-touch-icon" href={base + "apple-touch-icon.png"} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Outfit:wght@400;500;600;700;800&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href={base + "styles/global.css"} />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Remote Team Partners",
    "url": "https://remoteteampartners.com",
    "logo": "https://remoteteampartners.com/images/logo-light.webp",
    "description": "Remote Team Partners builds dedicated remote teams for US businesses, covering staffing, recruitment, accounting, HR, payroll and ongoing team management.",
    "areaServed": "United States",
    "contactPoint": { "@type": "ContactPoint", "contactType": "sales", "areaServed": "US" }
  }
  </script>
</head>
<body>
  <header class="nav">
    <div class="nav-in">
      <a href={base || "./"} class="wordmark" aria-label="Remote Team Partners home">
        <img src={base + "images/logo-light.webp"} alt="Remote Team Partners" width="186" height="34" class="wordmark-logo" loading="eager" fetchpriority="high" decoding="async" />
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={base + "#services"}>Services</a>
        <a href={base + "#process"}>How it works</a>
        <a href={base + "#pricing"}>Pricing</a>
        <a href={base + "#faq"}>FAQ</a>
        <a href={base + "contact/"}>Contact</a>
      </nav>
      <button class="nav-burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <a href={base + "contact/"} class="btn btn-blue btn-sm nav-cta">Book a Call <span class="arr-c" set:html={arrow}></span></a>
    </div>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <nav aria-label="Mobile">
        <a href={base + "#services"}>Services</a>
        <a href={base + "#process"}>How it works</a>
        <a href={base + "#pricing"}>Pricing</a>
        <a href={base + "#faq"}>FAQ</a>
        <a href={base + "contact/"}>Contact</a>
      </nav>
      <a href={base + "contact/"} class="btn btn-blue">Book a Discovery Call <span class="arr-c" set:html={arrow}></span></a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <div class="foot-brand"><img src={base + "images/logo-dark.webp"} alt="Remote Team Partners" width="186" height="34" class="foot-logo" loading="lazy" decoding="async" /></div>
          <p>Dedicated remote teams for US businesses. You lead your people, we build, support, and manage the workforce behind them.</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            <li><a href={base + "services/staffing-recruitment/"}>Staffing &amp; Recruitment</a></li>
            <li><a href={base + "services/accounting-finance/"}>Accounting &amp; Finance</a></li>
            <li><a href={base + "services/customer-support/"}>Customer Support</a></li>
            <li><a href={base + "services/admin-operations/"}>Admin &amp; Operations</a></li>
            <li><a href={base + "services/it-software/"}>IT &amp; Software</a></li>
            <li><a href={base + "services/marketing-sales/"}>Marketing &amp; Sales</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href={base + "#process"}>How it works</a></li>
            <li><a href={base + "#pricing"}>Pricing</a></li>
            <li><a href={base + "#faq"}>FAQ</a></li>
            <li><a href={base + "contact/"}>Contact us</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href={base + "terms/"}>Terms of Service</a></li>
            <li><a href={base + "privacy/"}>Privacy Policy</a></li>
            <li><a href={base + "cookies/"}>Cookie Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-base">
        <span>© 2026 Remote Team Partners. All rights reserved.</span>
        <span>Serving businesses across the United States.</span>
      </div>
    </div>
  </footer>
  <script>
    // Smooth scroll for same-page anchors
    document.querySelectorAll('a[href^="#"]').forEach(function(a){
      a.addEventListener('click', function(e){
        var t = document.querySelector(a.getAttribute('href'));
        if (t) { e.preventDefault(); t.scrollIntoView({behavior:'smooth'}); }
      });
    });
    // Mobile menu toggle
    var burger = document.querySelector('.nav-burger');
    var menu = document.getElementById('mobile-menu');
    function closeMenu(){
      if (!menu || menu.hidden) return;
      menu.hidden = true;
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open menu');
    }
    if (burger && menu) {
      burger.addEventListener('click', function(){
        var open = menu.hidden;
        menu.hidden = !open;
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
      menu.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click', closeMenu);
      });
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeMenu();
      });
      window.addEventListener('resize', function(){
        if (window.innerWidth >= 1020) closeMenu();
      });
    }
  </script>
</body>
</html>
