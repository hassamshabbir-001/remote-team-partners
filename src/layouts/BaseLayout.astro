---
export interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = "/" } = Astro.props;
const site = "https://remoteteampartners.com";
const canonical = `${site}${path}`;
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Remote Team Partners" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%230A1130'/><circle cx='38' cy='42' r='14' fill='%237C5CFF'/><circle cx='62' cy='58' r='14' fill='%2338E1FF' opacity='0.85'/></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Remote Team Partners",
    "url": "https://remoteteampartners.com",
    "description": "Remote Team Partners builds dedicated remote teams for US businesses, covering staffing, recruitment, accounting, HR, payroll and ongoing team management.",
    "areaServed": "United States",
    "contactPoint": { "@type": "ContactPoint", "contactType": "sales", "areaServed": "US" }
  }
  </script>
</head>
<body>
  <header class="nav">
    <div class="nav-inner">
      <a href="/" class="logo" aria-label="Remote Team Partners home">
        <span class="logo-mark" aria-hidden="true"><span class="lm-a"></span><span class="lm-b"></span></span>
        <span class="logo-text">Remote Team <strong>Partners</strong></span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#services">Services</a>
        <a href="#process">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a href="#cta" class="btn btn-primary btn-sm">Book a Call</a>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="footer">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <div class="logo-text foot-logo">Remote Team <strong>Partners</strong></div>
          <p>Dedicated remote teams for US businesses. You lead your people, we build, support, and manage the workforce behind them.</p>
        </div>
        <div>
          <h4>Services</h4>
          <ul>
            <li><a href="#services">Staffing &amp; Recruitment</a></li>
            <li><a href="#services">Accounting &amp; Finance</a></li>
            <li><a href="#services">Customer Support</a></li>
            <li><a href="#services">Admin &amp; Operations</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="#process">How it works</a></li>
            <li><a href="#pricing">Pricing</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#cta">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-base">
        <span>© 2026 Remote Team Partners. All rights reserved.</span>
        <span>Serving businesses across the United States.</span>
      </div>
    </div>
  </footer>
  <script>
    document.querySelectorAll('a[href^="#"]').forEach(function(a){
      a.addEventListener('click', function(e){
        var t = document.querySelector(a.getAttribute('href'));
        if (t) { e.preventDefault(); t.scrollIntoView({behavior:'smooth'}); }
      });
    });
  </script>
</body>
</html>
