---
import BaseLayout from "../../layouts/BaseLayout.astro";
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
const tick = "✓";
---

<BaseLayout
  title="Accounting & Finance | Remote Team Partners"
  description="Dedicated remote bookkeepers, accountants, and payroll specialists for US businesses. Accurate books, clean reporting, one monthly investment."
  path="/services/accounting-finance/"
  base="../../"
>
  <!-- HERO -->
  <section class="hero hero-slim">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="../../">Home</a><span class="sep">/</span>
        <a href="../../#services">Services</a><span class="sep">/</span>
        <span class="cur">Accounting &amp; Finance</span>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="dot"></span> Accounting &amp; Finance</span>
          <h1>Accurate books, <span class="hl">clean reporting,</span> zero hiring overhead.</h1>
          <p class="sub">Dedicated bookkeepers, accountants, and payroll specialists who work exclusively for you, inside your tools and your processes.</p>
          <div class="hero-ctas">
            <a href="../../contact/" class="btn btn-blue">Book a Discovery Call <span class="arr-c" set:html={arrow}></span></a>
            <a href="../../#pricing" class="btn btn-white">See Pricing <span class="arr-c" set:html={arrow}></span></a>
          </div>
          <div class="hero-proof">
            <div class="proof-item"><strong>5 weeks</strong><span>first call to working team</span></div>
            <div class="proof-item"><strong>1 invoice</strong><span>predictable monthly cost</span></div>
            <div class="proof-item"><strong>Guaranteed</strong><span>replacement on every hire</span></div>
          </div>
        </div>
        <div class="hero-media">
          <div class="ph">
            <img src="../../images/accounting-finance-services.webp" srcset="../../images/accounting-finance-services-mobile.webp 640w, ../../images/accounting-finance-services.webp 1280w" sizes="(max-width: 640px) 640px, 1280px" alt="Accounting and finance services, professional reviewing financial documents" width="960" height="640" loading="eager" fetchpriority="high" />
          </div>
          <div class="float-card fc-1">
            <span class="ic"><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <div><strong>Month end close</strong><span>reconciled and reported on time</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow"><span class="dot"></span> What you get</span>
        <h2>Finance support you can rely on.</h2>
        <p>Professionals who treat your numbers with the care they deserve. Here is what is included.</p>
      </div>
      <div class="deliver-grid">
        <div class="deliver-card">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
          <h3>Dedicated bookkeeper</h3>
          <p>A professional assigned to your accounts, reconciling and categorizing on your schedule.</p>
        </div>
        <div class="deliver-card">
          <span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
          <h3>Month end close</h3>
          <p>A structured close process with checklists, reviews, and reporting delivered on time.</p>
        </div>
        <div class="deliver-card">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg></span>
          <h3>Financial reporting</h3>
          <p>P&amp;L, balance sheet, and cash flow reports prepared the way you need them.</p>
        </div>
        <div class="deliver-card">
          <span class="ic"><svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg></span>
          <h3>Payroll support</h3>
          <p>Payroll processing and coordination, handled accurately and on schedule.</p>
        </div>
        <div class="deliver-card">
          <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg></span>
          <h3>Your tools, your process</h3>
          <p>We work inside QuickBooks, Xero, NetSuite, or your existing stack. No forced migrations.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <div class="band-black">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow on-dark"><span class="dot"></span> How it works</span>
        <h2 style="margin-top:20px">From messy books to clean close.</h2>
        <p class="lede">A clear four step process. You always know what comes next.</p>
      </div>
      <div class="steps-list">
        <div class="step-row"><span class="snum">01</span><div><h3>Map your books</h3><p>We review your chart of accounts, tools, and reporting needs.</p></div></div>
        <div class="step-row"><span class="snum">02</span><div><h3>Match the professional</h3><p>We source accountants with the right software experience and industry background.</p></div></div>
        <div class="step-row"><span class="snum">03</span><div><h3>You interview</h3><p>Meet the shortlist and confirm the fit before onboarding.</p></div></div>
        <div class="step-row"><span class="snum">04</span><div><h3>Close with confidence</h3><p>Structured onboarding into your close calendar, then steady, accurate output.</p></div></div>
      </div>
    </div>
  </div>

  <!-- ROLES -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="dot"></span> Roles we fill</span>
        <h2>Finance roles we place every week.</h2>
        <p>From daily bookkeeping to controllership, we cover the full finance function.</p>
      </div>
      <div class="roles">
        <span class="role-pill">Bookkeeper</span>
        <span class="role-pill">Staff Accountant</span>
        <span class="role-pill">Senior Accountant</span>
        <span class="role-pill">Payroll Specialist</span>
        <span class="role-pill">Accounts Payable Clerk</span>
        <span class="role-pill">Accounts Receivable Clerk</span>
        <span class="role-pill">Financial Analyst</span>
        <span class="role-pill">Controller</span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="dot"></span> FAQ</span>
        <h2>Finance questions, answered.</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Which accounting software do you support? <span class="plus">+</span></summary>
          <div class="faq-a">QuickBooks, Xero, NetSuite, Sage, and most major platforms. Your professional works inside your existing stack.</div>
        </details>
        <details class="faq-item">
          <summary>How do you handle sensitive financial data? <span class="plus">+</span></summary>
          <div class="faq-a">Professionals work under NDA, with access controls defined by you. We follow your security policies.</div>
        </details>
        <details class="faq-item">
          <summary>Can you handle month end close? <span class="plus">+</span></summary>
          <div class="faq-a">Yes. We build a close checklist around your calendar and deliver reconciled books and reports on schedule.</div>
        </details>
        <details class="faq-item">
          <summary>Who employs the professionals? <span class="plus">+</span></summary>
          <div class="faq-a">We do. Employment contracts, payroll, benefits administration, and compliance are our responsibility.</div>
        </details>
        <details class="faq-item">
          <summary>What if the accountant does not work out? <span class="plus">+</span></summary>
          <div class="faq-a">Every engagement includes a replacement guarantee. We source a replacement without disrupting your operations.</div>
        </details>
        <details class="faq-item">
          <summary>What does it cost? <span class="plus">+</span></summary>
          <div class="faq-a">One monthly investment per professional: $1,500 for Associates, $2,500 for Professionals, and from $5,000 for Experts. Recruitment is included, with no separate placement fees.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="sec" id="cta" style="padding-bottom:88px">
    <div class="wrap">
      <div class="cta-card">
        <span class="cta-dot d1" aria-hidden="true"></span>
        <span class="cta-dot d2" aria-hidden="true"></span>
        <div class="cta-copy">
          <span class="eyebrow"><span class="dot"></span> Get started</span>
          <h2>Hire smarter. Scale faster.</h2>
          <p>Clean books and on time reporting start with the right person. Book a call and meet yours within weeks.</p>
          <div class="cta-row">
            <a href="mailto:hello@remoteteampartners.com" class="btn btn-blue">Book a Discovery Call <span class="arr-c" set:html={arrow}></span></a>
            <a href="../../#pricing" class="btn btn-white">See Pricing <span class="arr-c" set:html={arrow}></span></a>
          </div>
          <ul class="cta-points">
            <li><span class="tick">{tick}</span> No recruitment fees, ever</li>
            <li><span class="tick">{tick}</span> Replacement guarantee included</li>
            <li><span class="tick">{tick}</span> Scale up or down as you grow</li>
          </ul>
        </div>
        <div class="cta-media">
          <img src="../../images/business-partnership-meeting.webp" alt="Business partnership meeting, two professionals shaking hands" width="800" height="600" loading="lazy" />
          <div class="cta-float">
            <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
            <div><strong>5 weeks to a working team</strong><span>from first call to fully onboarded</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Accounting & Finance",
    "description": "Dedicated remote bookkeepers, accountants, and payroll specialists for US businesses. Accurate books, clean reporting, one monthly investment.",
    "provider": { "@type": "Organization", "name": "Remote Team Partners", "url": "https://www.remoteteampartners.com" },
    "areaServed": "United States",
    "url": "https://www.remoteteampartners.com/services/accounting-finance/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.remoteteampartners.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.remoteteampartners.com/#services" },
      { "@type": "ListItem", "position": 3, "name": "Accounting & Finance", "item": "https://www.remoteteampartners.com/services/accounting-finance/" }
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Which accounting software do you support?", "acceptedAnswer": { "@type": "Answer", "text": "QuickBooks, Xero, NetSuite, Sage, and most major platforms. Your professional works inside your existing stack." } },
      { "@type": "Question", "name": "How do you handle sensitive financial data?", "acceptedAnswer": { "@type": "Answer", "text": "Professionals work under NDA, with access controls defined by you. We follow your security policies." } },
      { "@type": "Question", "name": "Can you handle month end close?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We build a close checklist around your calendar and deliver reconciled books and reports on schedule." } },
      { "@type": "Question", "name": "Who employs the professionals?", "acceptedAnswer": { "@type": "Answer", "text": "Remote Team Partners employs them, handling contracts, payroll, benefits, and compliance." } },
      { "@type": "Question", "name": "What if the accountant does not work out?", "acceptedAnswer": { "@type": "Answer", "text": "Every engagement includes a replacement guarantee." } },
      { "@type": "Question", "name": "What does it cost?", "acceptedAnswer": { "@type": "Answer", "text": "One monthly investment: $1,500 for Associates, $2,500 for Professionals, from $5,000 for Experts. Recruitment is included." } }
    ]
  }
  </script>
</BaseLayout>
