---
import BaseLayout from "../layouts/BaseLayout.astro";
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
const tick = "✓";
---

<BaseLayout
  title="Remote Team Partners | Dedicated Remote Teams for US Businesses"
  description="Remote Team Partners builds dedicated remote teams for US businesses. Staffing, recruitment, accounting, HR, payroll and full team management, one predictable monthly investment."
  path="/"
>
  <!-- HERO: asymmetric left-aligned -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="dot"></span> Now hiring for US businesses</span>
          <h1>Build your <span class="hl">dedicated remote team</span>, without the hiring headache.</h1>
          <p class="sub">We recruit, employ, onboard, and manage exceptional remote professionals who work exclusively for you. You lead the work, we handle everything behind it.</p>
          <div class="hero-ctas">
            <a href="#cta" class="btn btn-blue">Book a Discovery Call <span class="arr-c" set:html={arrow}></span></a>
            <a href="#pricing" class="btn btn-white">See Pricing <span class="arr-c" set:html={arrow}></span></a>
          </div>
          <div class="hero-proof">
            <div class="proof-item"><strong>5 weeks</strong><span>first call to working team</span></div>
            <div class="proof-item"><strong>20+ roles</strong><span>one partner, every function</span></div>
            <div class="proof-item"><strong>1 invoice</strong><span>predictable monthly cost</span></div>
          </div>
        </div>
        <div class="hero-media">
          <div class="ph">
            <img src="images/remote-team-video-call.webp" srcset="images/remote-team-video-call-mobile.webp 960w, images/remote-team-video-call.webp 1920w" sizes="(max-width: 640px) 100vw, 880px" alt="Dedicated remote team on a video call from modern home offices" width="880" height="560" loading="eager" fetchpriority="high" />
          </div>
          <div class="float-card fc-1">
            <span class="ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/></svg></span>
            <div><strong>Exclusively yours</strong><span>your team works only for you</span></div>
          </div>
          <div class="float-card fc-2">
            <span class="ic"><svg viewBox="0 0 24 24"><path d="M12 2 4 6v6c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <div><strong>Replacement guarantee</strong><span>every engagement covered</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES: asymmetric bento -->
  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow"><span class="dot"></span> Services</span>
        <h2>Every role your business needs, remotely.</h2>
        <p>If a role can be performed remotely, we can build the team to support it.</p>
      </div>
      <div class="brands">
        <article class="brand-card brand-large">
          <div class="brand-img"><img src="images/staffing-recruitment-services.webp" srcset="images/staffing-recruitment-services-mobile.webp 960w, images/staffing-recruitment-services.webp 1920w" sizes="(max-width: 640px) 100vw, 800px" alt="Staffing and recruitment services, professional job interview" width="800" height="720" loading="lazy" /></div>
          <div class="brand-info">
            <div>
              <span class="brand-slug">Hiring</span>
              <h3>Staffing &amp; Recruitment</h3>
              <p>Targeted sourcing, thorough vetting, and client interviews. We present exceptional candidates, not long lists.</p>
            </div>
            <a href="services/staffing-recruitment/" class="brand-arrow" aria-label="Learn more about Staffing and Recruitment"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
          </div>
        </article>
        <div class="brand-stack">
          <article class="brand-card">
            <div class="brand-img"><img src="images/accounting-finance-services.webp" srcset="images/accounting-finance-services-mobile.webp 960w, images/accounting-finance-services.webp 1920w" sizes="(max-width: 640px) 100vw, 640px" alt="Accounting and finance services, professional reviewing financial documents" width="640" height="340" loading="lazy" /></div>
            <div class="brand-info">
              <div>
                <span class="brand-slug">Finance</span>
                <h3>Accounting &amp; Finance</h3>
                <p>Bookkeepers and accountants who keep your numbers accurate.</p>
              </div>
              <a href="services/accounting-finance/" class="brand-arrow" aria-label="Learn more about Accounting and Finance"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
            </div>
          </article>
          <article class="brand-card">
            <div class="brand-img"><img src="images/customer-support-services.webp" srcset="images/customer-support-services-mobile.webp 960w, images/customer-support-services.webp 1920w" sizes="(max-width: 640px) 100vw, 640px" alt="Customer support services, friendly specialist with headset" width="640" height="340" loading="lazy" /></div>
            <div class="brand-info">
              <div>
                <span class="brand-slug">Support</span>
                <h3>Customer Support</h3>
                <p>Specialists trained on your product, tone, and customers.</p>
              </div>
              <a href="services/customer-support/" class="brand-arrow" aria-label="Learn more about Customer Support"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
            </div>
          </article>
        </div>
        <article class="brand-card brand-third">
          <div class="brand-img"><img src="images/admin-operations-services.webp" srcset="images/admin-operations-services-mobile.webp 960w, images/admin-operations-services.webp 1920w" sizes="(max-width: 640px) 100vw, 480px" alt="Admin and operations services, organized modern office workspace" width="480" height="300" loading="lazy" /></div>
          <div class="brand-info">
            <div>
              <span class="brand-slug">Operations</span>
              <h3>Admin &amp; Operations</h3>
              <p>Assistants and coordinators who keep things running.</p>
            </div>
            <a href="services/admin-operations/" class="brand-arrow" aria-label="Learn more about Admin and Operations"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
          </div>
        </article>
        <article class="brand-card brand-third">
          <div class="brand-img"><img src="images/it-software-services.webp" srcset="images/it-software-services-mobile.webp 960w, images/it-software-services.webp 1920w" sizes="(max-width: 640px) 100vw, 480px" alt="IT and software services, developer writing code" width="480" height="300" loading="lazy" /></div>
          <div class="brand-info">
            <div>
              <span class="brand-slug">Technology</span>
              <h3>IT &amp; Software</h3>
              <p>Developers and IT support vetted for skill and reliability.</p>
            </div>
            <a href="services/it-software/" class="brand-arrow" aria-label="Learn more about IT and Software"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
          </div>
        </article>
        <article class="brand-card brand-third">
          <div class="brand-img"><img src="images/marketing-sales-services.webp" srcset="images/marketing-sales-services-mobile.webp 960w, images/marketing-sales-services.webp 1920w" sizes="(max-width: 640px) 100vw, 480px" alt="Marketing and sales services, team strategy meeting" width="480" height="300" loading="lazy" /></div>
          <div class="brand-info">
            <div>
              <span class="brand-slug">Growth</span>
              <h3>Marketing &amp; Sales</h3>
              <p>Marketers and sales reps who grow your pipeline.</p>
            </div>
            <a href="services/marketing-sales/" class="brand-arrow" aria-label="Learn more about Marketing and Sales"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a>
          </div>
        </article>
      </div>
      <div class="roles">
        <span class="role-pill">Data Analysis</span>
        <span class="role-pill">Graphic Design</span>
        <span class="role-pill">Video Editing</span>
        <span class="role-pill">Legal Support</span>
        <span class="role-pill">Healthcare Admin</span>
        <span class="role-pill">Procurement</span>
        <span class="role-pill">Project Management</span>
        <span class="role-pill">Research</span>
        <span class="role-pill">Ecommerce</span>
        <span class="role-pill">Business Development</span>
      </div>
    </div>
  </section>

  <!-- MODEL -->
  <div class="band-blue">
    <div class="wrap">
      <div style="text-align:center">
        <span class="eyebrow"><span class="dot"></span> The model</span>
      </div>
      <h2>A workforce partner, not a staffing agency.</h2>
      <p class="lede">Traditional hiring means managing everything. Traditional outsourcing sacrifices control. We give you the best of both worlds.</p>
      <div class="duo">
        <div class="duo-card duo-white">
          <h3>You control</h3>
          <ul>
            <li><span class="tick">{tick}</span> Business decisions and priorities</li>
            <li><span class="tick">{tick}</span> Daily work and workflows</li>
            <li><span class="tick">{tick}</span> Performance standards</li>
            <li><span class="tick">{tick}</span> Training and development direction</li>
          </ul>
        </div>
        <div class="duo-card duo-dark">
          <h3>We manage</h3>
          <ul>
            <li><span class="tick">{tick}</span> Recruitment and candidate vetting</li>
            <li><span class="tick">{tick}</span> Employment contracts and compliance</li>
            <li><span class="tick">{tick}</span> HR administration and payroll</li>
            <li><span class="tick">{tick}</span> Engagement, retention, and replacements</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- PROCESS: horizontal rows -->
  <div class="band-black" id="process">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow on-dark"><span class="dot"></span> How it works</span>
        <h2 style="margin-top:20px">From first call to long-term team.</h2>
        <p class="lede">You always know what comes next. Here is exactly what your first five weeks look like.</p>
      </div>
      <div class="steps-list">
        <div class="step-row"><span class="snum">01</span><div><h3>Understand your business</h3><p>We learn your goals, workflows, and what success looks like for each role.</p></div></div>
        <div class="step-row"><span class="snum">02</span><div><h3>Define the ideal candidate</h3><p>Together we build a precise profile: skills, experience, and cultural fit.</p></div></div>
        <div class="step-row"><span class="snum">03</span><div><h3>Source targeted talent</h3><p>We recruit specifically for you. No database of ready-made resumes.</p></div></div>
        <div class="step-row"><span class="snum">04</span><div><h3>Evaluate and vet</h3><p>Thorough screening and assessment before you ever see a profile.</p></div></div>
        <div class="step-row"><span class="snum">05</span><div><h3>You interview and select</h3><p>Meet only the most qualified professionals and choose who you prefer.</p></div></div>
        <div class="step-row"><span class="snum">06</span><div><h3>Onboard and support</h3><p>Structured onboarding, then ongoing HR, payroll, and management from us.</p></div></div>
      </div>
    </div>
  </div>

  <!-- PRICING -->
  <section class="sec" id="pricing">
    <div class="wrap">
      <div class="sec-head left">
        <span class="eyebrow"><span class="dot"></span> Pricing</span>
        <h2>Simple. Transparent. Predictable.</h2>
        <p>One monthly investment covers recruitment, employment, HR, payroll, and ongoing support. No recruitment fees. No hidden costs.</p>
      </div>
      <div class="price-grid">
        <div class="price-card">
          <span class="price-tag">Associate</span>
          <h3>Core Associate</h3>
          <div class="price-amount">$1,500<small>/month</small></div>
          <ul>
            <li><span class="tick">{tick}</span> Up to 2 years of experience</li>
            <li><span class="tick">{tick}</span> Dedicated professional, exclusively yours</li>
            <li><span class="tick">{tick}</span> Recruitment and vetting included</li>
            <li><span class="tick">{tick}</span> HR administration and payroll</li>
            <li><span class="tick">{tick}</span> Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-black">Choose Associate <span class="arr-c" set:html={arrow}></span></a>
        </div>
        <div class="price-card dark">
          <span class="price-tag">Most popular</span>
          <h3>Core Professional</h3>
          <div class="price-amount">$2,500<small>/month</small></div>
          <ul>
            <li><span class="tick">{tick}</span> 2 to 6 years of experience</li>
            <li><span class="tick">{tick}</span> Dedicated professional, exclusively yours</li>
            <li><span class="tick">{tick}</span> Recruitment and vetting included</li>
            <li><span class="tick">{tick}</span> HR administration and payroll</li>
            <li><span class="tick">{tick}</span> Compliance support</li>
            <li><span class="tick">{tick}</span> Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-blue">Choose Professional <span class="arr-c" set:html={arrow}></span></a>
        </div>
        <div class="price-card">
          <span class="price-tag">Expert</span>
          <h3>Core Expert</h3>
          <div class="price-amount" style="font-size:36px">From $5,000<small>/month</small></div>
          <ul>
            <li><span class="tick">{tick}</span> 6+ years of experience</li>
            <li><span class="tick">{tick}</span> Dedicated professional, exclusively yours</li>
            <li><span class="tick">{tick}</span> Recruitment and vetting included</li>
            <li><span class="tick">{tick}</span> HR administration and payroll</li>
            <li><span class="tick">{tick}</span> Personalized client success support</li>
            <li><span class="tick">{tick}</span> Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-black">Choose Expert <span class="arr-c" set:html={arrow}></span></a>
        </div>
      </div>
      <p class="price-note">Every plan includes employee engagement, ongoing support, and the option to scale up or down as you grow.</p>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="sec" id="industries">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="dot"></span> Industries</span>
        <h2>Built for the businesses that run on operations.</h2>
        <p>Dedicated remote teams shaped around your industry's workflows, tools, and customers.</p>
      </div>
      <div class="post-grid">
        <article class="post-card">
          <a class="pc-img" href="industries/real-estate/" aria-label="Remote teams for real estate businesses">
            <img src="images/remote-customer-support-specialist.webp" alt="Remote teams for real estate businesses, transaction coordination support" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">Real Estate</span>
            <h3><a href="industries/real-estate/">Remote Teams for Real Estate</a></h3>
            <p>Transaction coordinators, inside sales agents, and listing administrators who keep your pipeline moving.</p>
            <a class="post-more" href="industries/real-estate/">Explore real estate teams</a>
          </div>
        </article>
        <article class="post-card">
          <a class="pc-img" href="industries/ecommerce/" aria-label="Remote teams for e-commerce businesses">
            <img src="images/marketing-sales-services.webp" srcset="images/marketing-sales-services-mobile.webp 640w, images/marketing-sales-services.webp 1280w" sizes="(max-width: 640px) 640px, 640px" alt="Remote teams for e-commerce businesses, store operations and support" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">E-commerce</span>
            <h3><a href="industries/ecommerce/">Remote Teams for E-commerce</a></h3>
            <p>Customer support, order operations, and store administration that scale with your sales and seasons.</p>
            <a class="post-more" href="industries/ecommerce/">Explore e-commerce teams</a>
          </div>
        </article>
        <article class="post-card">
          <a class="pc-img" href="industries/law-firms/" aria-label="Remote teams for law firms">
            <img src="images/accounting-finance-services.webp" srcset="images/accounting-finance-services-mobile.webp 640w, images/accounting-finance-services.webp 1280w" sizes="(max-width: 640px) 640px, 640px" alt="Remote teams for law firms, legal assistants and intake specialists" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">Law Firms</span>
            <h3><a href="industries/law-firms/">Remote Teams for Law Firms</a></h3>
            <p>Legal assistants, intake specialists, and billing support that give attorneys their hours back.</p>
            <a class="post-more" href="industries/law-firms/">Explore law firm teams</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FROM THE BLOG -->
  <section class="sec" id="insights" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="dot"></span> Resources</span>
        <h2>Guides on cost, hiring, and remote teams.</h2>
        <p>The numbers and processes behind building a dedicated remote team, from our <a href="blog/">blog</a>.</p>
      </div>
      <div class="post-grid">
        <article class="post-card">
          <a class="pc-img" href="blog/virtual-assistant-cost/" aria-label="How much does a virtual assistant cost in 2026">
            <img src="images/admin-operations-services.webp" srcset="images/admin-operations-services-mobile.webp 640w, images/admin-operations-services.webp 1280w" sizes="(max-width: 640px) 640px, 640px" alt="How much does a virtual assistant cost in 2026, pricing guide" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">Pricing</span>
            <h3><a href="blog/virtual-assistant-cost/">How Much Does a Virtual Assistant Cost in 2026?</a></h3>
            <p>Freelancer rates, agency pricing, and dedicated professional costs by role, plus the hidden costs nobody quotes.</p>
            <a class="post-more" href="blog/virtual-assistant-cost/">Read the guide</a>
          </div>
        </article>
        <article class="post-card">
          <a class="pc-img" href="blog/remote-team-vs-in-house-cost/" aria-label="Remote team vs in-house team cost comparison">
            <img src="images/business-partnership-meeting.webp" srcset="images/business-partnership-meeting-mobile.webp 640w, images/business-partnership-meeting.webp 1280w" sizes="(max-width: 640px) 640px, 640px" alt="Remote team vs in-house team, the true cost comparison" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">Cost Comparison</span>
            <h3><a href="blog/remote-team-vs-in-house-cost/">Remote Team vs In-House Team: The True Cost Comparison</a></h3>
            <p>Salary is only part of an in-house hire. The full loaded cost, line by line, against a dedicated remote team.</p>
            <a class="post-more" href="blog/remote-team-vs-in-house-cost/">Read the comparison</a>
          </div>
        </article>
        <article class="post-card">
          <a class="pc-img" href="blog/how-to-hire-remote-employees/" aria-label="How to hire remote employees, step by step guide">
            <img src="images/staffing-recruitment-services.webp" srcset="images/staffing-recruitment-services-mobile.webp 640w, images/staffing-recruitment-services.webp 1280w" sizes="(max-width: 640px) 640px, 640px" alt="How to hire remote employees, a step by step guide for US businesses" width="640" height="400" loading="lazy" />
          </a>
          <div class="pc-body">
            <span class="post-tag">Hiring Guide</span>
            <h3><a href="blog/how-to-hire-remote-employees/">How to Hire Remote Employees: A Step-by-Step Guide</a></h3>
            <p>Define the role, screen for remote traits, test with real work, and onboard for the first 30 days.</p>
            <a class="post-more" href="blog/how-to-hire-remote-employees/">Read the guide</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><span class="dot"></span> FAQ</span>
        <h2>Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How is this different from a staffing agency? <span class="plus">+</span></summary>
          <div class="faq-a">Staffing agencies end the relationship after placement. We employ your professionals, manage HR, payroll, compliance, engagement, and replacements for as long as you work with us. Your team works exclusively for you, under your direction.</div>
        </details>
        <details class="faq-item">
          <summary>How quickly can my team start? <span class="plus">+</span></summary>
          <div class="faq-a">From the first discovery call to a working professional is typically five weeks: one week to define the role, two weeks of sourcing and vetting, one week of interviews, and onboarding in week five.</div>
        </details>
        <details class="faq-item">
          <summary>Who employs the team members? <span class="plus">+</span></summary>
          <div class="faq-a">We do. We handle employment contracts, payroll, benefits administration, and local compliance, so you get productive professionals without the operational complexity.</div>
        </details>
        <details class="faq-item">
          <summary>What if a team member does not work out? <span class="plus">+</span></summary>
          <div class="faq-a">Every engagement includes a replacement guarantee. If someone is not the right fit, we source and onboard a replacement without disrupting your operations.</div>
        </details>
        <details class="faq-item">
          <summary>Which roles can you fill? <span class="plus">+</span></summary>
          <div class="faq-a">If a role can be performed remotely, we can fill it: accounting, customer support, admin, IT, software development, marketing, sales, design, data analysis, legal support, and more.</div>
        </details>
        <details class="faq-item">
          <summary>How does pricing work? <span class="plus">+</span></summary>
          <div class="faq-a">One predictable monthly investment per professional: $1,500 for Associates, $2,500 for Professionals, and from $5,000 for Experts. Everything else, recruitment, HR, payroll, compliance, support, is included.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="sec" id="cta">
    <div class="wrap">
      <div class="cta-card">
        <span class="cta-dot d1" aria-hidden="true"></span>
        <span class="cta-dot d2" aria-hidden="true"></span>
        <div class="cta-copy">
          <span class="eyebrow"><span class="dot"></span> Get started</span>
          <h2>Hire smarter. Scale faster.</h2>
          <p>The question is no longer whether to grow your team, it is how quickly you can build the right one. Schedule your discovery call today.</p>
          <div class="cta-row">
            <a href="mailto:hello@remoteteampartners.com" class="btn btn-blue">Book a Discovery Call <span class="arr-c" set:html={arrow}></span></a>
            <a href="#pricing" class="btn btn-white">See Pricing <span class="arr-c" set:html={arrow}></span></a>
          </div>
          <ul class="cta-points">
            <li><span class="tick">{tick}</span> No recruitment fees, ever</li>
            <li><span class="tick">{tick}</span> Replacement guarantee included</li>
            <li><span class="tick">{tick}</span> Scale up or down as you grow</li>
          </ul>
        </div>
        <div class="cta-media">
          <img src="images/business-partnership-meeting.webp" alt="Business partnership meeting, two professionals shaking hands" width="800" height="600" loading="lazy" />
          <div class="cta-float">
            <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></span>
            <div><strong>5 weeks to a working team</strong><span>from first call to fully onboarded</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
