---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Remote Team Partners | Dedicated Remote Teams for US Businesses"
  description="Remote Team Partners builds dedicated remote teams for US businesses. Staffing, recruitment, accounting, HR, payroll and full team management, one predictable monthly investment."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-inner">
        <div>
          <span class="eyebrow"><span class="dot"></span> Now hiring for US businesses</span>
          <h1>Build your <span class="grad">dedicated remote team</span>, without the hiring headache.</h1>
          <p class="lead">We recruit, employ, onboard, and manage exceptional remote professionals who work exclusively for you. You lead the work, we handle everything behind it.</p>
          <div class="hero-ctas">
            <a href="#cta" class="btn btn-primary">Book a Discovery Call <span class="arr">→</span></a>
            <a href="#pricing" class="btn btn-glass">See Pricing</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-img">
            <img src="/images/remote-team-video-call.webp" alt="Diverse remote team on a video call from modern home offices" width="880" height="440" loading="eager" fetchpriority="high" />
          </div>
          <div class="glass-card gc-1">
            <div class="gc-num">5 weeks</div>
            <div class="gc-label">from first call to working team</div>
          </div>
          <div class="glass-card gc-2">
            <div class="gc-num">20+ roles</div>
            <div class="gc-label">one partner for every function</div>
          </div>
        </div>
      </div>
      <div class="hero-stats">
        <div class="hstat"><div class="n"><em>100%</em> dedicated</div><div class="l">professionals work only for you</div></div>
        <div class="hstat"><div class="n">1 <em>invoice</em></div><div class="l">one predictable monthly investment</div></div>
        <div class="hstat"><div class="n"><em>0</em> HR overhead</div><div class="l">we manage HR, payroll, compliance</div></div>
      </div>
    </div>
  </section>

  <!-- YOU CONTROL / WE MANAGE -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">The model</span>
        <h2>A workforce partner, not a staffing agency.</h2>
        <p>Traditional hiring means managing everything. Traditional outsourcing sacrifices control. We give you the best of both worlds.</p>
      </div>
      <div class="split">
        <div class="split-dark">
          <h3>You control</h3>
          <ul>
            <li><span class="tick">✓</span> Business decisions and priorities</li>
            <li><span class="tick">✓</span> Daily work and workflows</li>
            <li><span class="tick">✓</span> Performance standards</li>
            <li><span class="tick">✓</span> Training and development direction</li>
          </ul>
        </div>
        <div class="split-light">
          <h3>We manage</h3>
          <ul>
            <li><span class="tick">✓</span> Recruitment and candidate vetting</li>
            <li><span class="tick">✓</span> Employment contracts and compliance</li>
            <li><span class="tick">✓</span> HR administration and payroll</li>
            <li><span class="tick">✓</span> Engagement, retention, and replacements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="sec" id="services" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Services</span>
        <h2>Every role your business needs, remotely.</h2>
        <p>If a role can be performed remotely, we can build the team to support it.</p>
      </div>
      <div class="svc-grid">
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17.5" cy="9.5" r="2.5"/><path d="M16 14.6c2.9.3 5 2.4 5 5.4"/></svg></div>
          <h3>Staffing &amp; Recruitment</h3>
          <p>Targeted sourcing, thorough vetting, and client interviews. We present exceptional candidates, not long lists.</p>
        </article>
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V10l7-5 7 5v11"/><path d="M9 21v-6h6v6"/><path d="M9 14h.01M15 14h.01"/></svg></div>
          <h3>Accounting &amp; Finance</h3>
          <p>Bookkeepers, accountants, and finance professionals who keep your numbers accurate and on time.</p>
        </article>
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/></svg></div>
          <h3>Customer Support</h3>
          <p>Dedicated support specialists trained on your product, your tone, and your customers.</p>
        </article>
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.11-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.89a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h.09A1.7 1.7 0 0 0 10.11 3V3a2 2 0 1 1 4 0v.09c0 .68.4 1.3 1 1.55.61.26 1.32.11 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v.09c.26.61.88 1 1.55 1H21a2 2 0 1 1 0 4h-.09c-.68 0-1.3.4-1.51 1z"/></svg></div>
          <h3>Admin &amp; Operations</h3>
          <p>Executive assistants, operations coordinators, and data specialists who keep things running.</p>
        </article>
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="m8 8-5 4 5 4"/><path d="m16 8 5 4-5 4"/><path d="m13 4-2 16"/></svg></div>
          <h3>IT &amp; Software</h3>
          <p>Developers, IT support, and technical specialists vetted for skill and reliability.</p>
        </article>
        <article class="svc-card">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="m3 11 18-8-8 18-2.5-7.5z"/><path d="M11.5 14.5 21 3"/></svg></div>
          <h3>Marketing &amp; Sales</h3>
          <p>Marketers, designers, and sales development reps who grow your pipeline.</p>
        </article>
      </div>
      <div style="margin-top:44px">
        <div class="sec-head" style="margin-bottom:24px">
          <p style="margin-top:0">Plus many more roles:</p>
        </div>
        <div class="roles">
          <span class="role-pill">Data Analysis</span>
          <span class="role-pill">Graphic Design</span>
          <span class="role-pill">Video Editing</span>
          <span class="role-pill">Legal Support</span>
          <span class="role-pill">Healthcare Admin</span>
          <span class="role-pill">Procurement</span>
          <span class="role-pill">Project Management</span>
          <span class="role-pill">Research</span>
          <span class="role-pill">Ecommerce</span>
          <span class="role-pill">Business Development</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="sec" id="process" style="padding-top:0">
    <div class="wrap">
      <div class="process">
        <div class="sec-head">
          <span class="kicker">How it works</span>
          <h2>From first call to long-term team.</h2>
          <p>You always know what comes next. Here is exactly what your first five weeks look like.</p>
        </div>
        <div class="steps">
          <div class="step"><div class="snum">Step 01</div><h3>Understand your business</h3><p>We learn your goals, workflows, and what success looks like for each role.</p></div>
          <div class="step"><div class="snum">Step 02</div><h3>Define the ideal candidate</h3><p>Together we build a precise profile: skills, experience, and cultural fit.</p></div>
          <div class="step"><div class="snum">Step 03</div><h3>Source targeted talent</h3><p>We recruit specifically for you. No database of ready-made resumes.</p></div>
          <div class="step"><div class="snum">Step 04</div><h3>Evaluate and vet</h3><p>Thorough screening and assessment before you ever see a profile.</p></div>
          <div class="step"><div class="snum">Step 05</div><h3>You interview and select</h3><p>Meet only the most qualified professionals and choose who you prefer.</p></div>
          <div class="step"><div class="snum">Step 06</div><h3>Onboard and support</h3><p>Structured onboarding, then ongoing HR, payroll, and management from us.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="sec" id="pricing" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Pricing</span>
        <h2>Simple. Transparent. Predictable.</h2>
        <p>One monthly investment covers recruitment, employment, HR, payroll, and ongoing support. No recruitment fees. No hidden costs.</p>
      </div>
      <div class="price-grid">
        <div class="price-card">
          <span class="price-badge">Associate</span>
          <h3>Core Associate</h3>
          <div class="price-amount">$1,500<small>/month</small></div>
          <ul>
            <li>Up to 2 years of experience</li>
            <li>Dedicated professional, exclusively yours</li>
            <li>Recruitment and vetting included</li>
            <li>HR administration and payroll</li>
            <li>Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-outline" style="justify-content:center">Choose Associate</a>
        </div>
        <div class="price-card featured">
          <span class="price-badge">Most popular</span>
          <h3>Core Professional</h3>
          <div class="price-amount">$2,500<small>/month</small></div>
          <ul>
            <li>2 to 6 years of experience</li>
            <li>Dedicated professional, exclusively yours</li>
            <li>Recruitment and vetting included</li>
            <li>HR administration and payroll</li>
            <li>Compliance support</li>
            <li>Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-primary" style="justify-content:center">Choose Professional</a>
        </div>
        <div class="price-card">
          <span class="price-badge">Expert</span>
          <h3>Core Expert</h3>
          <div class="price-amount" style="font-size:38px">From $5,000<small>/month</small></div>
          <ul>
            <li>6+ years of experience</li>
            <li>Dedicated professional, exclusively yours</li>
            <li>Recruitment and vetting included</li>
            <li>HR administration and payroll</li>
            <li>Personalized client success support</li>
            <li>Replacement guarantee</li>
          </ul>
          <a href="#cta" class="btn btn-outline" style="justify-content:center">Choose Expert</a>
        </div>
      </div>
      <p class="price-note">Every plan includes employee engagement, ongoing support, and the option to scale up or down as you grow.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">FAQ</span>
        <h2>Frequently asked questions.</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How is this different from a staffing agency? <span class="plus">+</span></summary>
          <div class="faq-a">Staffing agencies end the relationship after placement. We employ your professionals, manage HR, payroll, compliance, engagement, and replacements for as long as you work with us. Your team works exclusively for you, under your direction.</div>
        </details>
        <details class="faq-item">
          <summary>How quickly can my team start? <span class="plus">+</span></summary>
          <div class="faq-a">From the first discovery call to a working professional is typically five weeks: one week to define the role, two weeks of sourcing and vetting, one week of interviews, and onboarding in week five.</div>
        </details>
        <details class="faq-item">
          <summary>Who employs the team members? <span class="plus">+</span></summary>
          <div class="faq-a">We do. We handle employment contracts, payroll, benefits administration, and local compliance, so you get productive professionals without the operational complexity.</div>
        </details>
        <details class="faq-item">
          <summary>What if a team member does not work out? <span class="plus">+</span></summary>
          <div class="faq-a">Every engagement includes a replacement guarantee. If someone is not the right fit, we source and onboard a replacement without disrupting your operations.</div>
        </details>
        <details class="faq-item">
          <summary>Which roles can you fill? <span class="plus">+</span></summary>
          <div class="faq-a">If a role can be performed remotely, we can fill it: accounting, customer support, admin, IT, software development, marketing, sales, design, data analysis, legal support, and more.</div>
        </details>
        <details class="faq-item">
          <summary>How does pricing work? <span class="plus">+</span></summary>
          <div class="faq-a">One predictable monthly investment per professional: $1,500 for Associates, $2,500 for Professionals, and from $5,000 for Experts. Everything else, recruitment, HR, payroll, compliance, support, is included.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="sec" id="cta" style="padding-top:0">
    <div class="wrap">
      <div class="final">
        <h2>Hire smarter. Scale faster.</h2>
        <p>The question is no longer whether to grow your team, it is how quickly you can build the right one. Schedule your discovery call today.</p>
        <div class="row">
          <a href="mailto:hello@remoteteampartners.com" class="btn btn-primary">Book a Discovery Call <span class="arr">→</span></a>
          <a href="#pricing" class="btn btn-glass">See Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type": "Question", "name": "How is this different from a staffing agency?", "acceptedAnswer": {"@type": "Answer", "text": "Staffing agencies end the relationship after placement. Remote Team Partners employs your professionals and manages HR, payroll, compliance, engagement, and replacements for as long as you work with us."}},
      {"@type": "Question", "name": "How quickly can my team start?", "acceptedAnswer": {"@type": "Answer", "text": "From the first discovery call to a working professional is typically five weeks."}},
      {"@type": "Question", "name": "Who employs the team members?", "acceptedAnswer": {"@type": "Answer", "text": "Remote Team Partners employs them, handling contracts, payroll, benefits, and compliance."}},
      {"@type": "Question", "name": "What if a team member does not work out?", "acceptedAnswer": {"@type": "Answer", "text": "Every engagement includes a replacement guarantee."}},
      {"@type": "Question", "name": "How does pricing work?", "acceptedAnswer": {"@type": "Answer", "text": "One predictable monthly investment: $1,500 for Associates, $2,500 for Professionals, from $5,000 for Experts."}}
    ]
  }
  </script>
</BaseLayout>
