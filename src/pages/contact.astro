---
import BaseLayout from "../layouts/BaseLayout.astro";
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
---

<BaseLayout
  title="Contact Us | Remote Team Partners"
  description="Talk to Remote Team Partners about building your dedicated remote team. Send a message or book a discovery call, we reply within one business day."
  path="/contact/"
  base="../"
>
  <!-- HERO -->
  <section class="hero hero-slim">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="../">Home</a><span class="sep">/</span>
        <span class="cur">Contact</span>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow"><span class="dot"></span> Contact</span>
          <h1>Let's talk about <span class="hl">your team</span>.</h1>
          <p class="sub">Tell us what you need to build. We reply within one business day, usually much faster.</p>
          <div class="hero-proof">
            <div class="proof-item"><strong>1 day</strong><span>response time</span></div>
            <div class="proof-item"><strong>30 minutes</strong><span>discovery call</span></div>
            <div class="proof-item"><strong>No fees</strong><span>to start the conversation</span></div>
          </div>
        </div>
        <div class="contact-side">
          <div class="contact-card">
            <h3>Prefer email?</h3>
            <p>Write to us directly and we will take it from there.</p>
            <a class="contact-mail" href="mailto:hello@remoteteampartners.com">hello@remoteteampartners.com</a>
          </div>
          <div class="contact-card">
            <h3>What happens next</h3>
            <ol class="next-steps">
              <li><strong>We reply</strong> within one business day.</li>
              <li><strong>Discovery call:</strong> 30 minutes to map your needs.</li>
              <li><strong>Team proposal:</strong> vetted candidates within days.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section class="sec" style="padding-bottom:88px">
    <div class="wrap">
      <div class="form-card">
        <div class="sec-head left">
          <span class="eyebrow"><span class="dot"></span> Send a message</span>
          <h2>Start the conversation.</h2>
          <p>Fill in the form and we will get back to you within one business day.</p>
        </div>
        <form id="contact-form" action="https://formspree.io/f/xaeeygqk" method="POST" novalidate>
          <input type="hidden" name="_subject" value="New enquiry from remoteteampartners.com" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-grid">
            <div class="field">
              <label for="cf-name">Full name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" placeholder="Jane Smith" required />
            </div>
            <div class="field">
              <label for="cf-email">Work email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" placeholder="jane@company.com" required />
            </div>
            <div class="field">
              <label for="cf-company">Company</label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder="Company Inc." />
            </div>
            <div class="field">
              <label for="cf-service">What do you need?</label>
              <select id="cf-service" name="service">
                <option>Staffing and Recruitment</option>
                <option>Accounting and Finance</option>
                <option>Customer Support</option>
                <option>Admin and Operations</option>
                <option>IT and Software</option>
                <option>Marketing and Sales</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field field-full">
              <label for="cf-msg">Your message</label>
              <textarea id="cf-msg" name="message" rows="5" placeholder="Tell us about the roles you want to fill and your timeline." required></textarea>
            </div>
          </div>
          <p class="form-error" id="form-error" hidden>Please add your name, a valid email, and a message.</p>
          <button type="submit" class="btn btn-blue" id="cf-submit">Send Message <span class="arr-c" set:html={arrow}></span></button>
          <p class="form-note">Your message goes straight to our team, and we reply within one business day. We never share your details.</p>
        </form>
        <div id="form-success" hidden>
          <h3 style="font-size:24px;margin-bottom:10px">Thank you, your message is on its way.</h3>
          <p style="color:var(--gray);margin:0">We have received your enquiry and will reply within one business day. If it is urgent, write to us at <a href="mailto:hello@remoteteampartners.com" style="color:var(--blue);font-weight:600">hello@remoteteampartners.com</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function(){
      var form = document.getElementById('contact-form');
      if (!form) return;
      form.addEventListener('submit', function(e){
        e.preventDefault();
        var name = document.getElementById('cf-name').value.trim();
        var email = document.getElementById('cf-email').value.trim();
        var message = document.getElementById('cf-msg').value.trim();
        var err = document.getElementById('form-error');
        var btn = document.getElementById('cf-submit');
        var validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        if (!name || !validEmail || !message) {
          err.textContent = 'Please add your name, a valid email, and a message.';
          err.hidden = false;
          return;
        }
        err.hidden = true;
        btn.disabled = true;
        btn.style.opacity = '0.65';
        btn.firstChild.textContent = 'Sending... ';
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        }).then(function(res){
          if (res.ok) {
            form.hidden = true;
            document.getElementById('form-success').hidden = false;
          } else {
            btn.disabled = false;
            btn.style.opacity = '';
            btn.firstChild.textContent = 'Send Message ';
            err.textContent = 'Something went wrong while sending. Please try again, or email us at hello@remoteteampartners.com.';
            err.hidden = false;
          }
        }).catch(function(){
          btn.disabled = false;
          btn.style.opacity = '';
          btn.firstChild.textContent = 'Send Message ';
          err.textContent = 'Something went wrong while sending. Please try again, or email us at hello@remoteteampartners.com.';
          err.hidden = false;
        });
      });
    })();
  </script>
</BaseLayout>
